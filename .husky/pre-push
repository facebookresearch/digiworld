#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check for git-lfs
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"

# Enforce branch naming convention
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
TYPES="feature|task|bugfix|hotfix|chore|patch|fix|refactor|docs|test|ci"
if [[ ! "$BRANCH_NAME" =~ ^(app-[^/]+/($TYPES)/|multi/[^/]+/($TYPES)/|multi/all/($TYPES)/|infra/|($TYPES)/).+ ]] && [[ "$BRANCH_NAME" != "main" ]] && [[ "$BRANCH_NAME" != "master" ]]; then
  echo "❌ Branch name '$BRANCH_NAME' does not follow the required convention." >&2
  echo "Expected formats:" >&2
  echo "  - {type}/{description}" >&2
  echo "  - app-{appname}/{type}/{description}" >&2
  echo "  - multi/{appname}/{type}/{description}" >&2
  echo "  - multi/all/{type}/{description}" >&2
  echo "  - infra/{description}" >&2
  echo "Where type is one of: feature, task, bugfix, hotfix, chore, patch, fix, refactor, docs, test, ci" >&2
  exit 1
fi

# Fail if package-lock.json exists
if [ -f package-lock.json ]; then
  echo "❌ package-lock.json found. Please use only yarn.lock for dependency management." >&2
  exit 1
fi

# Run format check
echo "Running format check..."
yarn format:check || exit 1

# Run lint-staged
echo "Running lint-staged..."
yarn lint-staged || exit 1

# Run tests
echo "Running tests..."
yarn test || exit 1

echo "✅ All pre-push checks passed!"
