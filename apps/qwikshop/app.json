{
  "name": "andoho-qwikshop-sbx",
  "displayName": "Andojo QwikShop",
  "expo": {
    "name": "Andojo QwikShop",
    "slug": "andojo-qwikshop-sbx",
    "scheme": "andojoqwikshop",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/app-icon-all.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "icon": "./assets/images/app-icon-android-legacy.png",
      "package": "com.andojoqwikshop.sbx",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
        "backgroundImage": "./assets/images/app-icon-android-adaptive-background.png"
      },
      "buildProperties": {
        "kotlinVersion": "1.9.25"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "andojoqwikshop",
              "host": "sbx",
              "pathPrefix": "/event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "backgroundColor": "#FDE3F0",
        "image": "./assets/images/splash-logo-android-universal.png",
        "resizeMode": "contain"
      },
      "allowBackup": false
    },
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.andojoqwikshop.sbx",
      "associatedDomains": [
        "applinks:sbx.andojoqwikshop.com"
      ],
      "splash": {
        "backgroundColor": "#FDE3F0",
        "image": "./assets/images/splash-logo-ios-mobile.png",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/images/app-icon-web-favicon.png",
      "bundler": "metro",
      "splash": {
        "backgroundColor": "#FDE3F0",
        "image": "./assets/images/splash-logo-web.png",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon-android-adaptive-foreground.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#becbce"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#FDE3F0",
      "image": "./assets/images/splash-logo-all.png",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0374cd8e-fb73-47ed-b3ab-af9e57705684"
      }
    }
  },
  "ignite": {
    "version": "10.1.0"
  }
}
