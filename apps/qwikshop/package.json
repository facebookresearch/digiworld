{
  "name": "@andojo/qwikshop",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "compile": "tsc --noEmit -p . --pretty",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "patch": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test .maestro/FavoritePodcast.yaml",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "bundle:visualize": "npx react-native-bundle-visualizer",
    "bundle:visualize:dev": "npx react-native-bundle-visualizer --dev",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:dev": "eas build --profile development:device --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:dev": "eas build --profile development:device --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local",
    "start": "npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npx expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx server dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "e2e:build": "detox build -c android.emu.debug",
    "e2e:test": "detox test -c android.emu.debug",
    "test:e2e": "npm run e2e:build && npm run e2e:test",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "apk:android": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@andojo/shared-asset-management": "1.0.0",
    "@andojo/shared-interaction-tracking": "0.0.1",
    "@andojo/shared-mock-reader": "1.0.0",
    "@andojo/shared-theme": "0.0.1",
    "@expo-google-fonts/space-grotesk": "0.2.3",
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "^14.0.3",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "apisauce": "3.0.1",
    "base-64": "^1.0.0",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.43.1",
    "expo": "~52.0.7",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.7",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.2",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.14",
    "expo-splash-screen": "~0.29.10",
    "expo-sqlite": "~15.1.2",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "^4.0.8",
    "expo-updates": "~0.27.1",
    "i18n-js": "^4.4.3",
    "i18next": "^24.2.2",
    "intl-pluralrules": "^2.0.1",
    "mobx": "6.10.2",
    "mobx-react-lite": "4.0.5",
    "mobx-state-tree": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.4.1",
    "react-native": "0.76.9",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keyboard-controller": "^1.16.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.2.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.6",
    "reactotron-react-native-mmkv": "^0.2.8",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/plugin-transform-arrow-functions": "^7.0.0",
    "@babel/plugin-transform-shorthand-properties": "^7.0.0",
    "@babel/plugin-transform-template-literals": "^7.0.0",
    "@types/i18n-js": "3.8.2",
    "@types/jest": "^29.5.14",
    "glob": "^9",
    "rimraf": "^4",
    "ts-jest": "^29.3.4",
    "uuid": "^14"
  },
  "engines": {
    "node": ">=18"
  }
}
