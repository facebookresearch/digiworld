{
  "name": "@andojo/ryde",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "compile": "tsc --noEmit -p . --pretty",
    "format": "eslint . --fix",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "patch": "patch-package",
    "postinstall": "ts-node scripts/copy-web-assets.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update": "jest -u",
    "test:clear": "jest --clearCache",
    "start": "expo start --dev-client",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx server dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "transfer-data": "chmod +x ./transfer-data.sh && ./transfer-data.sh",
    "reset-app": "npm run transfer-data && npm run reset-db",
    "reset-db": "rm -rf .expo/db.sqlite",
    "release:alpha": "BUILD_TYPE=alpha PRE_RELEASE=true node scripts/build-and-notify.js",
    "release:beta": "BUILD_TYPE=beta PRE_RELEASE=true RELEASE_NOTES=\"Beta release\" node scripts/build-and-notify.js",
    "release:rc": "BUILD_TYPE=rc PRE_RELEASE=true RELEASE_NOTES=\"RC testing\" node scripts/build-and-notify.js",
    "release:prod": "BUILD_TYPE=prod node scripts/build-and-notify.js",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "db:studio": "drizzle-kit studio",
    "uninstall": "adb uninstall com.andojoeats.sbx",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "apk:android": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@andojo/shared-interaction-tracking": "0.0.1",
    "@andojo/shared-theme": "0.0.1",
    "@expo-google-fonts/space-grotesk": "^0.2.3",
    "@expo/metro-runtime": "~4.0.0",
    "@maplibre/maplibre-react-native": "^10.1.6",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/native": "7",
    "@react-navigation/native-stack": "7",
    "@shopify/flash-list": "1.7.1",
    "apisauce": "3.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~52.0.7",
    "expo-asset": "~11.0.5",
    "expo-barcode-scanner": "^13.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-camera": "~16.0.10",
    "expo-document-picker": "~13.0.1",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "expo-file-system": "~18.0.7",
    "expo-font": "~13.0.1",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.2",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.14",
    "expo-splash-screen": "~0.29.10",
    "expo-sqlite": "~15.0.5",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.3",
    "expo-updates": "~0.26.18",
    "intl-pluralrules": "^2.0.1",
    "mobx": "6.10.2",
    "mobx-react-lite": "4.0.5",
    "mobx-state-tree": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keyboard-controller": "^1.12.7",
    "react-native-mmkv": "3.1.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
       "react-native-svg": "15.8.0",
    "react-native-webview": "^13.13.5",
    "react-native-zip-archive": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.72.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.30.5",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
  }
}
