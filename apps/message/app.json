{
  "name": "andojo-message",
  "displayName": "Andojo Message",
  "expo": {
    "name": "Andojo Message",
    "slug": "andojo-message",
    "scheme": "andojomessage",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app-icon-all.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "icon": "./assets/images/app-icon-android-legacy.png",
      "package": "com.andojomessage.sbx",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
        "backgroundImage": "./assets/images/app-icon-android-adaptive-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "andojomessage",
              "host": "sbx",
              "pathPrefix": "/event"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_CONTACTS"
      ],
      "providers": [
        {
          "name": "androidx.core.content.FileProvider",
          "authorities": "${applicationId}.fileprovider",
          "exported": false,
          "grantUriPermissions": true,
          "metaData": [
            {
              "name": "android.support.FILE_PROVIDER_PATHS",
              "resource": "@xml/file_paths"
            }
          ]
        }
      ],
      "resourceFiles": [
        {
          "source": "./android-resources/xml/file_paths.xml",
          "target": "res/xml/file_paths.xml"
        }
      ]
    },
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.andojomessage.sbx",
      "associatedDomains": ["applinks:sbx.andojomessage.com"],
      "appleTeamId": "DKYT695T8Y"
    },
    "web": {
      "favicon": "./assets/images/app-icon-web-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon-android-adaptive-foreground.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#191015"
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      ["expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    }
  },
  "ignite": {
    "version": "10.1.0"
  }
}
