{
  "name": "@andojo/park",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "patch": "patch-package",
    "test": "jest --setupFilesAfterEnv=./jest.setup.parking.ts --testPathPattern='__tests__/(unit|integration|static)'",
    "test:full": "jest --setupFilesAfterEnv=./jest.setup.parking.ts --testPathPattern=__tests__/full",
    "test:watch": "jest --watch --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:static": "jest --testPathPattern=__tests__/static --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:static:watch": "jest --watch --testPathPattern=__tests__/static --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:full:watch": "jest --watch --testPathPattern=__tests__/full --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:unit": "jest --testPathPattern=__tests__/unit --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:integration": "jest --testPathPattern=__tests__/integration --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:queries": "jest --testPathPattern=__tests__/unit/queries.test.ts --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:mutations": "jest --testPathPattern=__tests__/unit/mutations.test.ts --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:store": "jest --testPathPattern=__tests__/unit/parking-store.test.ts --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:booking": "jest --testPathPattern=__tests__/integration/parking-booking-flow.test.ts --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:cost": "jest --testPathPattern=__tests__/integration/parking-cost-calculation.test.ts --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:coverage:static": "jest --coverage --testPathPattern=__tests__/static --coverageReporters=text --coverageReporters=html --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:coverage:full": "jest --coverage --testPathPattern=__tests__/full --coverageReporters=text --coverageReporters=html --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:coverage:unit": "jest --coverage --testPathPattern=__tests__/unit --coverageReporters=text --coverageReporters=html --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:coverage:integration": "jest --coverage --testPathPattern=__tests__/integration --coverageReporters=text --coverageReporters=html --setupFilesAfterEnv=./jest.setup.parking.ts",
    "test:generate-static-db": "ts-node src/__tests__/static/generate-static-db.ts",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.andojomusic.sbx -e IS_DEV=true .maestro/flows",
    "test:maestro:ci": "maestro test -e MAESTRO_APP_ID=com.andojomusic.sbx -e IS_DEV=false .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "postinstall": "patch-package",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:dev": "eas build --profile development:device --platform ios --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:dev": "eas build --profile development:device --platform android --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "db:studio": "drizzle-kit studio",
    "uninstall": "adb uninstall com.andojoeats.sbx",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "android:dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 ANDROID_HOME=$HOME/Library/Android/sdk EAS_NO_VCS=1 GRADLE_OPTS='-Dorg.gradle.daemon=false' npx expo run:android --no-build-cache",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "apk:android": "cd android && ./gradlew assembleRelease",
    "build": "npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@andojo/shared-asset-management": "1.0.0",
    "@andojo/shared-interaction-tracking": "0.0.1",
    "@andojo/shared-mock-reader": "1.0.0",
    "@andojo/shared-theme": "0.0.1",
    "@expo-google-fonts/space-grotesk": "0.2.3",
    "@expo/metro-runtime": "~4.0.0",
    "@maplibre/maplibre-react-native": "^10.1.6",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/slider": "4.5.6",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "7",
    "@react-navigation/native-stack": "7",
    "apisauce": "3.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~52.0.7",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.1",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.1",
    "expo-linking": "~7.0.2",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.14",
    "expo-splash-screen": "~0.29.10",
    "expo-sqlite": "~15.0.5",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.3",
    "expo-video-thumbnails": "~9.0.3",
    "i18n-js": "^4.4.3",
    "i18next": "^24.2.2",
    "intl-pluralrules": "^2.0.1",
    "mobx": "6.10.2",
    "mobx-react-lite": "4.0.5",
    "mobx-state-tree": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.0.1",
    "react-native": "0.76.9",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keyboard-controller": "^1.12.7",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-shimmer": "^0.6.0",
    "react-native-video-info": "^0.1.3",
    "react-native-web": "~0.19.6",
    "react-native-zip-archive": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/parser": "^7.27.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@babel/traverse": "^7.27.1",
    "@react-native/codegen": "^0.79.2",
    "@testing-library/react-native": "^12.5.2",
    "@types/jest": "^29.2.1",
    "@types/react": "~18.3.12",
    "babel-jest": "^29.2.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "^0.30.5",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.1",
    "jest-html-reporter": "^4.1.0",
    "patch-package": "^8.0.0",
    "postinstall-prepare": "1.0.1",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-mst": "^3.1.11",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
  }
}
