{
  "name": "@andojo/email",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "compile": "tsc --noEmit -p . --pretty",
    "format": "eslint . --fix",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "patch": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test .maestro/FavoritePodcast.yaml",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "reset-app": "npm run transfer-data && npm run reset-db",
    "android:dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 ANDROID_HOME=$HOME/Library/Android/sdk EAS_NO_VCS=1 GRADLE_OPTS='-Dorg.gradle.daemon=false' npx expo run:android --no-build-cache",
    "uninstall": "adb uninstall com.andojomail.sbx",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "apk:android": "cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@andojo/shared-interaction-tracking": "0.0.1",
    "@andojo/shared-theme": "0.0.1",
    "@expo-google-fonts/space-grotesk": "^0.2.3",
    "@expo/metro-runtime": "~4.0.0",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/native": "7",
    "@react-navigation/native-stack": "7",
    "@shopify/flash-list": "1.7.1",
    "apisauce": "3.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~52.0.7",
    "expo-build-properties": "~0.13.1",
    "expo-camera": "~16.0.10",
    "expo-document-picker": "~13.0.1",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "expo-file-system": "~18.0.7",
    "expo-font": "~13.0.1",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.2",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.14",
    "expo-splash-screen": "~0.29.10",
    "expo-sqlite": "~15.0.5",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.3",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "mobx": "6.10.2",
    "mobx-react-lite": "4.0.5",
    "mobx-state-tree": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.0.1",
    "react-native": "0.76.9",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keyboard-controller": "^1.12.7",
    "react-native-mmkv": "3.1.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
       "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.30.1",
    "react-native-svg-transformer": "^1.5.0",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
  }
}
