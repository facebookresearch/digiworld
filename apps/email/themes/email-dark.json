      "primary600": "#7BB8FF",
      "secondary100": "#0D2E29",
      "secondary200": "#1A4A41",
      "secondary300": "#296659",
      "secondary400": "#388271",
      "secondary500": "#4CAF89",
      "accent100": "#3D2E1A",
