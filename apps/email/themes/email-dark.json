    "semantic": {
      "transparent": "rgba(0, 0, 0, 0)",
      "text": "#F2F2F7",
      "textDim": "#AEAEB2",
      "background": "#000000",
      "border": "#3A3A3C",
      "tint": "#5BA3FF",
      "tintInactive": "#8E8E93",
      "separator": "#2C2C2E",
      "error": "#FF6B6B",
      "errorBackground": "#3D1A1A"
