{
  "name": "Email Light",
  "mode": "light",
  "colors": {
    "palette": {
      "neutral100": "#FFFFFF",
      "neutral200": "#F5F7FA",
      "neutral300": "#E8ECF1",
      "neutral400": "#D0D7DE",
      "neutral500": "#8B949E",
      "neutral600": "#656D76",
      "neutral700": "#424A53",
      "neutral800": "#24292F",
      "neutral900": "#1C2128",
      "primary100": "#E3F0FF",
      "primary200": "#C6E1FF",
      "primary300": "#9CCEFF",
      "primary400": "#6FB3FF",
      "primary500": "#4A90E2",
      "primary600": "#2E7BD6",
      "secondary100": "#E0F7F4",
      "secondary200": "#B3EFE6",
      "secondary300": "#80E6D8",
      "secondary400": "#4DDCC9",
      "secondary500": "#20C997",
      "accent100": "#FFF4E6",
      "accent200": "#FFE4B3",
      "accent300": "#FFD180",
      "accent400": "#FFB84D",
      "accent500": "#FFA500",
      "angry100": "#FFEBEE",
      "angry200": "#FFCDD2",
      "angry300": "#EF9A9A",
      "angry400": "#E57373",
      "angry500": "#FF0000",
      "success100": "#E8F5E9",
      "success200": "#C8E6C9",
      "success300": "#A5D6A7",
      "success400": "#81C784",
      "success500": "#4CAF50",
      "overlay20": "rgba(28, 33, 40, 0.2)",
      "overlay50": "rgba(28, 33, 40, 0.5)"
    },
    "semantic": {
      "transparent": "rgba(0, 0, 0, 0)",
      "text": "#1C2128",
      "textDim": "#656D76",
      "background": "#FFFFFF",
      "border": "#E8ECF1",
      "tint": "#4A90E2",
      "tintInactive": "#8B949E",
      "separator": "#E8ECF1",
      "error": "#FF0000",
      "errorBackground": "#FFEBEE"
    }
  },
  "typography": {
    "primary": {
      "light": "spaceGroteskLight",
      "normal": "spaceGroteskRegular",
      "medium": "spaceGroteskMedium",
      "semiBold": "spaceGroteskSemiBold",
      "bold": "spaceGroteskBold"
    },
    "secondary": {
      "thin": "HelveticaNeue-Thin",
      "light": "HelveticaNeue-Light",
      "normal": "Helvetica Neue",
      "medium": "HelveticaNeue-Medium"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48,
    "3xl": 64
  },
  "borderRadius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "shadows": {
    "sm": {
      "shadowColor": "#1C2128",
      "shadowOffset": { "width": 0, "height": 1 },
      "shadowOpacity": 0.1,
      "shadowRadius": 2,
      "elevation": 1
    },
    "md": {
      "shadowColor": "#1C2128",
      "shadowOffset": { "width": 0, "height": 2 },
      "shadowOpacity": 0.15,
      "shadowRadius": 4,
      "elevation": 3
    },
    "lg": {
      "shadowColor": "#1C2128",
      "shadowOffset": { "width": 0, "height": 4 },
      "shadowOpacity": 0.2,
      "shadowRadius": 8,
      "elevation": 5
    }
  },
  "components": {
    "button": {
      "defaultHeight": 48,
      "defaultBorderRadius": 8,
      "defaultPaddingHorizontal": 24,
      "defaultPaddingVertical": 12,
      "fontSize": 16,
      "fontWeight": "600",
      "primaryBackground": "#4A90E2",
      "primaryText": "#FFFFFF",
      "secondaryBackground": "#20C997",
      "secondaryText": "#FFFFFF"
    },
    "input": {
      "defaultHeight": 48,
      "defaultBorderRadius": 8,
      "defaultPaddingHorizontal": 16,
      "defaultPaddingVertical": 12,
      "fontSize": 16,
      "fontWeight": "400",
      "backgroundColor": "#FFFFFF",
      "borderColor": "#E8ECF1",
      "borderWidth": 1,
      "placeholderColor": "#8B949E",
      "textColor": "#1C2128",
      "focusBorderColor": "#4A90E2"
    },
    "text": {
      "defaultFontSize": 16,
      "defaultLineHeight": 24,
      "headingFontSize": 24,
      "headingLineHeight": 32,
      "subheadingFontSize": 18,
      "subheadingLineHeight": 26
    },
    "screen": {
      "backgroundColor": "#FFFFFF",
      "paddingHorizontal": 16,
      "paddingVertical": 16
    }
  }
}
