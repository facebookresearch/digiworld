current_apps/

# Generated/temporary files (should not be committed)
**/app_state.db
**/db-forge*/

# Test artifacts
test_output*.log
test_results*.xml

# npm lockfile (project uses yarn)
package-lock.json

# Ignore non-default session artifacts from testing (keep only default sessions)
**/state_data/**/sessions/*
!**/state_data/**/sessions/default

# LLM-generated intermediate artifacts (regeneratable via profile_cli generate)
digiworld/digiworld/pipeline/apps/*/artifacts/openai_gpt-oss-120b/

# Pipeline output artifacts
digiworld/digiworld/pipeline/apps/*/output/

# QA screenshots - ignore source trajectories but track curated issue screenshots
quality_assurance/**/*_concat.png
!quality_assurance/**/_issues/*.png

# QA evaluation data - kept in separate infra/qa-evaluations branch
quality_assurance/*/
!quality_assurance/dashboard/
.claude/

.llama_key

# digiworld_eval: the `env/` package is a real source dir, not a virtualenv —
# override the venv rules above (env/ / ENV/) so it gets tracked.
!digiworld_eval/env/
!digiworld_eval/env/**
# ...but the negation above re-exposed compiled artifacts; keep those out.
digiworld_eval/env/**/__pycache__/
digiworld_eval/env/**/*.pyc
# Never commit eval run output.
digiworld_eval/results/

.dw_state_data/

# DigiWorld container build scratch space
docker/.cache/
